CI_ENVIRONMENT = production

# Generic CodeIgniter settings for a traditional host.
app.baseURL = 'https://pos.example.com/'
app.appTimezone = 'Asia/Manila'
app.forceGlobalSecureRequests = true
app.CSPEnabled = true

# Docker/Render aliases understood directly by GROOVE. Render supplies
# RENDER_EXTERNAL_URL automatically, so GROOVE_BASE_URL is only needed for a
# custom domain or an explicit canonical URL.
GROOVE_BASE_URL = 'https://pos.example.com/'

# Supply the real values through the hosting provider's secret manager or a
# private .env file. Never commit production credentials.
database.default.hostname = localhost
database.default.database = groove_pos_db
database.default.username = groove_pos_app
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Render-friendly equivalents for the settings above. These ordinary
# environment-variable names avoid hard-coded credentials in the image.
DB_HOST = localhost
DB_PORT = 3306
DB_DATABASE = groove_pos_db
DB_USERNAME = groove_pos_app
DB_PASSWORD =
DB_SSL = false

cookie.secure = true
cookie.httponly = true
cookie.samesite = Lax

logger.threshold = 4
